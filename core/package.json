{
  "name": "context-police-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI ajan hafızası için arka plan denetçisi — çekirdek",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "context-police": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.ts",
    "test:tools": "node --test --disable-warning=ExperimentalWarning ../tools/altin-set/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "scan": "node --disable-warning=ExperimentalWarning src/cli.ts scan"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
